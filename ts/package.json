{
    "name": "network-topology",
    "version": "7.3.0",
    "scripts": {
        "build-es6": "./node_modules/.bin/esbuild demo.ts --target=es2016 --bundle --format=iife --outfile=_build/bundle.js",
        "transpile-es5": "./node_modules/.bin/babel _build/bundle.js -o _build/bundle-es5.js",
        "dev": "./node_modules/.bin/esbuild demo.ts --target=es2016 --bundle --format=iife --outfile=bundle.js --watch",
        "serve": "./node_modules/.bin/http-server .",
        "build": "npm run build-es6;npm run transpile-es5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jsplumb-demonstrations/network-topology.git"
    },
    "author": "JsPlumb <hello@jsplumbtoolkit.com> (https://jsplumbtoolkit.com)",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/jsplumb-demonstrations/network-topology/issues"
    },
    "homepage": "https://github.com/jsplumb-demonstrations/network-topology#readme",
    "dependencies": {
        "@jsplumbtoolkit/browser-ui": "^7.3.0"
    },
    "devDependencies": {
        "babel-cli": "^6.26.0",
        "babel-preset-env": "^1.7.0",
        "esbuild": "0.17.18",
        "http-server": "^14.1.1"
    }
}